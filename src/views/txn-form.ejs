<%
  // 类型按钮从 TXN_TYPES 常量派生(按 group 分两组),标签改名时自动跟随
  var typeList = TXN_TYPES.filter(function(x){ return ['日常','借贷'].indexOf(x.group) >= 0; })
    .map(function(x){ return { key: x.key, label: x.label, icon: x.icon }; });
  var moreTypes = TXN_TYPES.filter(function(x){ return ['日常','借贷'].indexOf(x.group) < 0; })
    .map(function(x){ return { key: x.key, label: x.label, icon: x.icon }; });
  var cur = t.type || 'expense';
  // 「工资收入」是表单模式（非交易类型）：按比例分配到「其他」账户，落账为多笔 income（design D1）
  var isSalary = mode === 'create' && cur === 'salary';
  var salaryAccounts = form.accounts.filter(function(a){ return a.type === 'other'; });
  var isExtra = moreTypes.some(function(x){ return x.key === cur; });
  var multiAccount = ['transfer','invest_buy','invest_sell'].includes(cur);
  var noCategory = ['transfer','adjust'].includes(cur);
  var catKind = (cur === 'income' || isSalary) ? 'income' : 'expense';
  var amountValue = t.amount !== undefined ? t.amount : (t.amount_cents !== undefined && t.amount_cents !== null ? (t.amount_cents / 100).toFixed(2) : '');
  if (typeof amountValue === 'number') amountValue = amountValue.toFixed(2);
  var action = mode === 'edit' ? ('/transactions/' + t.id) : '/transactions';
%>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="flash error"><span><%= error %></span></div>
<% } %>

<form method="post" action="<%= action %>" id="txn-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="type" id="f-type" value="<%= cur %>">
  <input type="hidden" name="category_id" id="f-category" value="<%= t.category_id || '' %>">
  <input type="hidden" name="back" value="<%= back %>">

  <div class="grid grid-main">
    <div>
      <div class="card">
        <div class="row between mb12">
          <div class="type-tabs" style="flex:1">
            <% typeList.forEach(function(x){ %>
              <button type="button" data-type="<%= x.key %>" class="<%= cur === x.key ? 'active' : '' %>"><%= x.icon %> <%= x.label %></button>
            <% }); %>
          </div>
        </div>
        <div class="row mb16" style="gap:6px;flex-wrap:wrap">
          <span class="tiny muted">更多类型：</span>
          <% moreTypes.forEach(function(x){ %>
            <button type="button" class="chip <%= cur === x.key ? 'primary' : '' %>" data-type="<%= x.key %>"><%= x.icon %> <%= x.label %></button>
          <% }); %>
          <% if (mode === 'create') { %>
            <button type="button" class="chip <%= isSalary ? 'primary' : '' %>" data-type="salary" title="按比例分配到各「其他」账户">💰 工资收入</button>
          <% } %>
        </div>

        <div class="field">
          <label>金额</label>
          <div class="amount-input">
            <span class="cur">¥</span>
            <input type="text" name="amount" id="f-amount" inputmode="decimal" value="<%= amountValue %>" placeholder="0.00" required autocomplete="off">
          </div>
        </div>

        <div class="row wrap" style="gap:12px">
          <div class="field" style="flex:1;min-width:150px">
            <label>日期</label>
            <input type="date" name="txn_date" value="<%= (t.txn_date || '').slice(0,10) %>" required>
          </div>
          <div class="field" style="flex:1;min-width:150px">
            <label>记录人</label>
            <input type="text" value="<%= t.member_name || user.display_name %>" disabled style="opacity:.6">
          </div>
        </div>

        <div class="field">
          <label>参与成员 <span class="muted tiny">（谁参与了这笔交易，可多选；点名单快速加入）</span></label>
          <input type="text" name="people" id="f-people" value="<%= t.participant_names || '' %>" list="people-datalist" placeholder="多个成员用空格分隔，可直接输入新名字" autocomplete="off">
          <datalist id="people-datalist">
            <% (form.people || []).forEach(function(p){ %><option value="<%= p.name %>"></option><% }); %>
          </datalist>
          <% if ((form.people || []).length) { %>
          <div class="row wrap" style="gap:6px;margin-top:6px" id="people-chips">
            <% (form.people || []).forEach(function(p){ %>
              <button type="button" class="btn btn-sm btn-ghost person-chip" data-name="<%= p.name %>"><%= p.name %></button>
            <% }); %>
          </div>
          <% } %>
        </div>

        <div class="row wrap <%= isSalary ? 'hidden' : '' %>" id="acc-row" style="gap:12px">
          <div class="field" style="flex:1;min-width:160px">
            <label id="acc-label">支付账户</label>
            <select name="account_id" id="f-account">
              <option value="">请选择账户…</option>
              <% form.accounts.forEach(function(a){ %>
                <option value="<%= a.id %>" <%= Number(t.account_id) === Number(a.id) ? 'selected' : '' %>><%= a.icon %> <%= a.name %>（<%= helpers.fmtAmount(a.balance_cents) %>）</option>
              <% }); %>
            </select>
          </div>
          <div class="field" data-for-type="transfer,invest_buy,invest_sell,lend,borrow,repay_receive,repay_pay" style="flex:1;min-width:160px">
            <label id="to-acc-label">转入 / 投资账户</label>
            <select name="to_account_id" id="f-to-account">
              <option value="">请选择账户…</option>
              <% form.accounts.forEach(function(a){ %>
                <option value="<%= a.id %>" <%= Number(t.to_account_id) === Number(a.id) ? 'selected' : '' %>><%= a.icon %> <%= a.name %><%= ['receivable','payable'].includes(a.type) ? '（' + (a.type === 'receivable' ? '应收' : '应付') + '）' : '' %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="field <%= isSalary ? '' : 'hidden' %>" id="salary-alloc">
          <label>分配到以下账户 <span class="muted tiny">（按账户管理中为「其他」账户配置的工资分配比例）</span></label>
          <% if (!salaryAccounts.length) { %>
            <div class="notice small">账本中还没有「其他」类型账户。请先到 <a href="/accounts">账户管理</a> 创建「其他」账户并配置分配比例，再使用工资收入。</div>
          <% } else { %>
            <div id="salary-rows" style="border:1px solid var(--border);border-radius:10px;padding:4px 12px">
              <% salaryAccounts.forEach(function(a){ var r = Number(a.alloc_ratio) || 0; %>
                <div class="row between salary-row" data-ratio="<%= r %>" style="padding:8px 0;border-bottom:1px dashed var(--border)">
                  <div class="small"><%= a.icon %> <%= a.name %> <span class="muted tiny">（<%= helpers.fmtAmount(a.balance_cents) %>）</span></div>
                  <div class="right small">
                    <b class="salary-preview">0.00</b>
                    <span class="muted tiny"><%= r %>%<%= r ? '' : ' · 未设置比例' %></span>
                  </div>
                </div>
              <% }); %>
            </div>
            <div class="tiny muted mt8" id="salary-sum-hint"></div>
          <% } %>
          <div class="small mt8" id="salary-error" style="color:var(--expense);display:none"></div>
        </div>

        <div class="field">
          <label>商家 / 对方 <span class="muted tiny">（借贷时的对方姓名很关键）</span></label>
          <input type="text" name="merchant" value="<%= t.merchant || '' %>" placeholder="例如：肯德基 / 张三 / 房东">
        </div>

        <div class="field">
          <label>备注</label>
          <textarea name="note" rows="2" placeholder="补充说明，例如：和同事聚餐"><%= t.note || '' %></textarea>
        </div>

        <div class="row wrap" style="gap:12px">
          <div class="field" style="flex:1;min-width:150px">
            <label>标签 <span class="muted tiny">（可从已有标签选择，点标签快速加入）</span></label>
            <input type="text" name="tags" id="f-tags" value="<%= t.tag_names || '' %>" list="tags-datalist" placeholder="多个用空格分隔" autocomplete="off">
            <datalist id="tags-datalist">
              <% (form.tags || []).forEach(function(g){ %><option value="<%= g.name %>"></option><% }); %>
            </datalist>
            <% if ((form.tags || []).length) { %>
            <div class="row wrap" style="gap:6px;margin-top:6px" id="tag-chips">
              <% (form.tags || []).forEach(function(g){ %>
                <button type="button" class="btn btn-sm btn-ghost tag-chip" data-name="<%= g.name %>">#<%= g.name %></button>
              <% }); %>
            </div>
            <% } %>
          </div>
          <div class="field" style="flex:1;min-width:150px">
            <label>状态</label>
            <select name="status">
              <option value="cleared" <%= t.status !== 'pending' ? 'selected' : '' %>>已确认</option>
              <option value="pending" <%= t.status === 'pending' ? 'selected' : '' %>>待确认</option>
            </select>
          </div>
        </div>

        <div class="row wrap mb12" style="gap:16px">
          <label class="check"><input type="checkbox" name="is_reimbursable" value="1" <%= t.is_reimbursable ? 'checked' : '' %>> 这笔可以报销</label>
        </div>

        <details style="margin-top:4px">
          <summary class="small muted" style="cursor:pointer;margin-bottom:10px">多币种 / 汇率（可选）</summary>
          <div class="row wrap" style="gap:12px">
            <div class="field" style="flex:1;min-width:120px">
              <label>币种</label>
              <select name="currency">
                <% ['CNY','USD','EUR','HKD','JPY','GBP','KRW','SGD','AUD','CAD','TWD'].forEach(function(c){ %>
                  <option value="<%= c %>" <%= t.currency === c ? 'selected' : '' %>><%= c %></option>
                <% }); %>
              </select>
            </div>
            <div class="field" style="flex:1;min-width:120px">
              <label>汇率（折算为 <%= baseCurrency %>）</label>
              <input type="text" name="rate" value="<%= t.rate || 1 %>">
            </div>
          </div>
        </details>
      </div>

      <div class="card">
        <div class="card-head">
          <h2>AA 分账</h2>
          <span class="muted small">可选，用于朋友聚餐/团队开销</span>
        </div>
        <div id="split-rows">
          <% (splitRows || []).forEach(function(s){ %>
            <div class="row split-row mb8">
              <input type="text" name="split_name" value="<%= s.member_name || '' %>" placeholder="成员" style="flex:1">
              <input type="text" name="split_amount" inputmode="decimal" value="<%= s.share_cents ? (s.share_cents/100).toFixed(2) : '' %>" placeholder="金额" style="flex:1">
              <button type="button" class="btn btn-sm btn-ghost del-split">✕</button>
            </div>
          <% }); %>
        </div>
        <div class="row">
          <button type="button" class="btn btn-sm" id="add-split">＋ 添加分摊人</button>
          <button type="button" class="btn btn-sm btn-ghost" id="split-average">按人数均摊</button>
        </div>
      </div>
    </div>

    <div>
      <div class="card" id="f-cat-wrap">
        <div class="card-head">
          <h2>分类</h2>
          <span class="muted small" id="cat-hint"><%= t.category_path && t.category_path !== '未分类' ? t.category_path : '未选择' %></span>
        </div>

        <% ['expense','income'].forEach(function(kind){ %>
          <div class="cat-section <%= kind === catKind ? '' : 'hidden' %>" data-cat-kind="<%= kind %>">
            <div class="type-tabs mb12" style="background:transparent;border:0;padding:0;gap:6px">
              <% (kind === 'expense' ? form.expenseTree : form.incomeTree).forEach(function(root, idx){ %>
                <span class="chip cat-parent" data-target="root-<%= kind %>-<%= root.id %>" style="cursor:pointer"><%= root.icon %> <%= root.name %></span>
              <% }); %>
            </div>
            <div class="scroll-x" style="max-height:460px;overflow-y:auto">
              <% (kind === 'expense' ? form.expenseTree : form.incomeTree).forEach(function(root){ %>
                <div class="cat-group mb12">
                  <div class="small bold muted mb8"><%= root.icon %> <%= root.name %></div>
                  <div class="cat-grid">
                    <% root.children.forEach(function(c){ %>
                      <a class="cat-item <%= Number(t.category_id) === Number(c.id) ? 'selected' : '' %>" href="#" data-id="<%= c.id %>" data-name="<%= c.name %>" data-path="<%= root.name %>/<%= c.name %>">
                        <span class="ci"><%= c.icon %></span>
                        <span><%= c.name %></span>
                      </a>
                    <% }); %>
                    <a class="cat-item <%= Number(t.category_id) === Number(root.id) ? 'selected' : '' %>" href="#" data-id="<%= root.id %>" data-name="<%= root.name %>" data-path="<%= root.name %>（不细分）">
                      <span class="ci">📁</span>
                      <span>不细分</span>
                    </a>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="card">
        <div class="row">
          <button class="btn btn-primary btn-lg" type="submit" id="submit-btn" style="flex:1"><%= mode === 'edit' ? '保存修改' : '保存这一笔' %></button>
          <a class="btn btn-lg" href="<%= back %>">取消</a>
        </div>
        <% if (mode === 'edit') { %>
        <div class="mt12">
          <div class="kv"><span class="k">创建时间</span><span class="v mono"><%= helpers.fmtDateTime(t.created_at) %></span></div>
          <div class="kv"><span class="k">最后修改</span><span class="v mono"><%= helpers.fmtDateTime(t.updated_at) %></span></div>
          <div class="kv"><span class="k">来源</span><span class="v"><%= t.source %></span></div>
        </div>
        <% } %>
      </div>

      <div class="notice small">
        💡 提示：<b>转账</b>、<b>借贷</b>、<b>投资买卖</b> 不计入收支统计，只影响账户余额，这样统计口径更准确。
      </div>
    </div>
  </div>
</form>

<% if (mode === 'edit' && typeof images !== 'undefined' && images.length) { %>
  <div class="card" id="txn-images">
    <div class="card-head">
      <h2>📎 关联账单截图（<%= images.length %>）</h2>
      <a class="btn btn-sm btn-ghost" href="/attachments">全部截图 →</a>
    </div>
    <div class="gallery">
      <% images.forEach(function(img){ %>
        <figure>
          <img src="<%= img.url %>" alt="账单截图" data-zoom="<%= img.url %>" loading="lazy">
          <figcaption>
            <div class="tiny"><%= helpers.fmtDateTime(img.created_at) %> · <%= Math.round((img.size || 0) / 1024) %> KB</div>
          </figcaption>
        </figure>
      <% }); %>
    </div>
  </div>
<% } %>

<script>
(function(){
  // 类型相关的字段显隐（服务端已渲染，JS 仅做交互增强）
  var curType = <%- JSON.stringify(cur) %>;
  function fType(){ return document.getElementById('f-type'); }
  function applyType(type){
    document.querySelectorAll('[data-for-type]').forEach(function(el){
      el.classList.toggle('hidden', !el.dataset.forType.split(',').includes(type));
    });
    document.querySelectorAll('[data-not-type]').forEach(function(el){
      el.classList.toggle('hidden', el.dataset.notType.split(',').includes(type));
    });
    var catWrap = document.getElementById('f-cat-wrap');
    if (catWrap) catWrap.classList.toggle('hidden', type === 'transfer' || type === 'adjust');
    var isSal = type === 'salary';
    var kind = (type === 'income' || isSal) ? 'income' : 'expense';
    document.querySelectorAll('.cat-section').forEach(function(el){
      el.classList.toggle('hidden', el.dataset.catKind !== kind);
    });
    // 工资模式：隐藏单个账户下拉，显示分配账户行
    var accRow = document.getElementById('acc-row');
    if (accRow) accRow.classList.toggle('hidden', isSal);
    var alloc = document.getElementById('salary-alloc');
    if (alloc) {
      alloc.classList.toggle('hidden', !isSal);
      if (isSal) updateSalaryPreview();
    }
    // 账户字段标签随类型变化
    var accLabel = document.getElementById('acc-label');
    if (accLabel) {
      accLabel.textContent = type === 'expense' ? '支付账户'
        : type === 'income' ? '收款账户'
        : type === 'transfer' ? '从账户'
        : type === 'lend' ? '从哪个账户代付'
        : type === 'borrow' ? '收到哪个账户'
        : type === 'repay_receive' ? '收款账户'
        : type === 'repay_pay' ? '付款账户'
        : type === 'invest_buy' ? '付款账户'
        : type === 'invest_sell' ? '收款账户'
        : '账户';
    }
    // 借贷类对手方账户标签（应收/应付）
    var toAccLabel = document.getElementById('to-acc-label');
    if (toAccLabel) {
      toAccLabel.textContent = type === 'lend' ? '代付到哪个账户（应收）'
        : type === 'borrow' ? '从哪个账户借入（应付）'
        : type === 'repay_receive' ? '核销哪个应收账户'
        : type === 'repay_pay' ? '核销哪个应付账户'
        : type === 'transfer' ? '转入账户'
        : '转入 / 投资账户';
    }
  }
  applyType(curType);
  document.querySelectorAll('.type-tabs [data-type]').forEach(function(btn){
    btn.addEventListener('click', function(){ applyType(btn.dataset.type); });
  });
  document.querySelectorAll('.chip[data-type]').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.chip[data-type]').forEach(function(b){ b.classList.toggle('primary', b === btn); });
      if (fType()) fType().value = btn.dataset.type;
      applyType(btn.dataset.type);
    });
  });
  // 分类父级跳转
  document.querySelectorAll('.cat-parent').forEach(function(p){
    p.addEventListener('click', function(e){
      e.preventDefault();
      var name = p.textContent.trim().replace(/^\S+\s*/, '');
      document.querySelectorAll('.cat-group').forEach(function(g){
        var head = g.querySelector('.small.bold');
        if (head && head.textContent.indexOf(name) >= 0) g.scrollIntoView({ behavior:'smooth', block:'start' });
      });
    });
  });
  // 参与成员名单点选快速加入
  document.querySelectorAll('.person-chip').forEach(function(chip){
    chip.addEventListener('click', function(){
      var input = document.getElementById('f-people');
      if (!input) return;
      var name = chip.dataset.name;
      var cur = input.value.split(/[,，、\s]+/).filter(Boolean);
      if (cur.indexOf(name) < 0) cur.push(name);
      input.value = cur.join(' ');
    });
  });
  // 已有标签点选快速加入
  document.querySelectorAll('.tag-chip').forEach(function(chip){
    chip.addEventListener('click', function(){
      var input = document.getElementById('f-tags');
      if (!input) return;
      var name = chip.dataset.name;
      var cur = input.value.split(/[,，\s]+/).filter(Boolean);
      if (cur.indexOf(name) < 0) cur.push(name);
      input.value = cur.join(' ');
    });
  });

  /* 工资收入：按比例分配预览（与服务端 computeAllocation 同一整数规则） */
  function parseCents(v){
    var n = Math.round(parseFloat(String(v).replace(/[^\d.]/g, '')) * 100);
    return Number.isFinite(n) && n > 0 ? n : 0;
  }
  function updateSalaryPreview(){
    var rows = document.querySelectorAll('.salary-row');
    if (!rows.length) return;
    var total = parseCents((document.getElementById('f-amount') || {}).value);
    var parts = [];
    rows.forEach(function(r){
      var ratio = Number(r.dataset.ratio) || 0;
      parts.push({ el: r, ratio: ratio, cents: Math.floor((total * ratio) / 100) });
    });
    // 余数按比例降序逐户补 1 分（DOM 顺序即 id 升序，sort 稳定，与服务端并列规则一致）
    var order = parts.slice().sort(function(a, b){ return b.ratio - a.ratio; });
    var rem = total - parts.reduce(function(s, p){ return s + p.cents; }, 0);
    for (var i = 0; rem > 0 && order.length; i = (i + 1) % order.length) { order[i].cents++; rem--; }
    parts.forEach(function(p){
      var el = p.el.querySelector('.salary-preview');
      if (el) el.textContent = (p.cents / 100).toFixed(2);
    });
    var sum = parts.reduce(function(s, p){ return s + p.ratio; }, 0);
    var hint = document.getElementById('salary-sum-hint');
    if (hint) {
      hint.textContent = sum === 100
        ? '分配比例总和 100% ✓，合计分配 ' + (total / 100).toFixed(2) + ' 元'
        : '⚠️ 分配比例总和为 ' + sum + '%（应为 100%），请到账户管理调整';
    }
  }
  var amtInput = document.getElementById('f-amount');
  if (amtInput) amtInput.addEventListener('input', function(){ updateSalaryPreview(); });
  updateSalaryPreview();

  /* 工资模式提交守卫（点击保存时校验；金额与比例总和最终以服务端校验为准） */
  var submitBtn = document.getElementById('submit-btn');
  if (submitBtn) submitBtn.addEventListener('click', function(e){
    if (!fType() || fType().value !== 'salary') return;
    var err = document.getElementById('salary-error');
    var rows = document.querySelectorAll('.salary-row');
    var msg = '';
    if (!rows.length) {
      msg = '账本中没有「其他」类型账户，请先到账户管理创建并配置分配比例';
    } else if (!parseCents(amtInput ? amtInput.value : 0)) {
      msg = '请输入有效的工资金额';
    } else {
      var sum = 0;
      rows.forEach(function(r){ sum += Number(r.dataset.ratio) || 0; });
      if (sum !== 100) msg = '分配比例总和为 ' + sum + '%（应为 100%），请到账户管理调整';
    }
    if (!msg) return;
    e.preventDefault();
    if (err) { err.textContent = msg; err.style.display = ''; }
  });
})();
</script>
