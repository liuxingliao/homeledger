<div class="notice info mb16">
  系统内置了 <%= expenseTree.length + incomeTree.length %> 个一级分类、数百个二级分类。所有分类（含内置）都可修改名称、图标、颜色与删除——内置分类为全局共享，改名对所有账本生效；分类下有交易时不能删除，可先批量修改或删除相关交易。
</div>

<div class="grid grid-2">
  <% [ { title:'支出分类', tree: expenseTree }, { title:'收入分类', tree: incomeTree } ].forEach(function(sec){ %>
    <div class="card">
      <div class="card-head"><h2><%= sec.title %></h2>
        <span class="muted small">近一年使用统计</span>
      </div>
      <% sec.tree.forEach(function(root){ %>
        <div style="border-bottom:1px dashed var(--border);padding:8px 0">
          <div class="row between">
            <span class="bold"><%= root.icon %> <%= root.name %></span>
            <span class="row" style="gap:8px">
              <span class="muted tiny">合计 <%= helpers.fmtAmount(root.children.reduce(function(s,c){ return s + Number(c.stat.total); }, 0) + Number(root.stat.total)) %></span>
              <a href="#" class="cat-edit" data-id="<%= root.id %>" style="font-size:11px">编辑</a>
              <form method="post" action="/categories/<%= root.id %>/delete" style="display:inline" data-confirm="删除一级分类「<%= root.name %>」？其子分类会一并处理；分类下有交易时将无法删除。">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn btn-sm btn-ghost" style="padding:0 2px;font-size:10px;color:var(--expense)">删除</button>
              </form>
            </span>
          </div>
          <div class="cat-edit-form hidden mt8" data-id="<%= root.id %>" style="background:var(--card-2);padding:10px;border-radius:10px">
            <form method="post" action="/categories/<%= root.id %>" class="inline-form" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="text" name="name" value="<%= root.name %>" required style="width:140px">
              <input type="text" name="icon" value="<%= root.icon %>" style="width:60px">
              <input type="color" name="color" value="<%= root.color || '#4f7cff' %>" style="width:44px;padding:2px">
              <button class="btn btn-sm btn-primary" type="submit">保存</button>
            </form>
          </div>
          <div class="row wrap mt8" style="gap:6px">
            <% root.children.forEach(function(c){ %>
              <span class="chip" title="<%= c.stat.cnt %> 笔 · <%= helpers.fmtAmount(c.stat.total) %>">
                <%= c.icon %> <%= c.name %>
                <% if (Number(c.stat.cnt) > 0) { %><span class="muted tiny"><%= c.stat.cnt %></span><% } %>
                <a href="#" class="cat-edit" data-id="<%= c.id %>" style="font-size:10px">编辑</a>
                <form method="post" action="/categories/<%= c.id %>/delete" style="display:inline" data-confirm="删除分类「<%= c.name %>」？分类下有交易时将无法删除。">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="btn btn-sm btn-ghost" style="padding:0 2px;font-size:10px">✕</button>
                </form>
              </span>
              <span class="cat-edit-form hidden" data-id="<%= c.id %>" style="background:var(--card-2);padding:6px 10px;border-radius:8px;display:inline-flex;gap:6px;align-items:center">
                <form method="post" action="/categories/<%= c.id %>" class="inline-form" style="display:flex;gap:6px;align-items:center">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="text" name="name" value="<%= c.name %>" required style="width:120px">
                  <input type="text" name="icon" value="<%= c.icon %>" style="width:52px">
                  <input type="color" name="color" value="<%= c.color || '#4f7cff' %>" style="width:40px;padding:2px">
                  <button class="btn btn-sm btn-primary" type="submit">保存</button>
                </form>
              </span>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>
  <% }); %>
</div>

<div class="card">
  <div class="card-head"><h2>新建分类</h2></div>
  <form method="post" action="/categories">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row wrap" style="gap:12px">
      <div class="field" style="flex:1;min-width:140px">
        <label>分类名称</label>
        <input type="text" name="name" placeholder="例如：代驾" required>
      </div>
      <div class="field" style="flex:1;min-width:120px">
        <label>收支类型</label>
        <select name="kind">
          <option value="expense">支出</option>
          <option value="income">收入</option>
        </select>
      </div>
      <div class="field" style="flex:2;min-width:150px">
        <label>归属一级分类</label>
        <select name="parent_id">
          <option value="">作为一级分类</option>
          <optgroup label="支出">
            <% expenseTree.forEach(function(r){ %><option value="<%= r.id %>"><%= r.icon %> <%= r.name %></option><% }); %>
          </optgroup>
          <optgroup label="收入">
            <% incomeTree.forEach(function(r){ %><option value="<%= r.id %>"><%= r.icon %> <%= r.name %></option><% }); %>
          </optgroup>
        </select>
      </div>
      <div class="field" style="flex:0 0 80px"><label>图标</label><input type="text" name="icon" value="🏷️"></div>
      <div class="field" style="flex:0 0 80px"><label>颜色</label><input type="color" name="color" value="#4f7cff"></div>
      <div class="field"><button class="btn btn-primary" type="submit">添加</button></div>
    </div>
  </form>
</div>

<script>
(function(){
  document.querySelectorAll('.cat-edit').forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      var f = document.querySelector('.cat-edit-form[data-id="' + a.dataset.id + '"]');
      if (f) f.classList.toggle('hidden');
    });
  });
})();
</script>
